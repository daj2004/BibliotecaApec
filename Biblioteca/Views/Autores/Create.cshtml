@model BibliotecaUNAPEC.Models.Autor

@{
    ViewData["Title"] = "Crear Autor";
}

<div class="row justify-content-center fade-in">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-person-plus me-2"></i>Registrar Nuevo Autor</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre Completo</label>
                            <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ingrese el nombre del autor" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PaisOrigen" class="form-label fw-bold">País de Origen</label>
                            <input asp-for="PaisOrigen" class="form-control" placeholder="Ej. República Dominicana" />
                            <span asp-validation-for="PaisOrigen" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdiomaNativoId" class="form-label fw-bold">Idioma Nativo</label>
                            <select asp-for="IdiomaNativoId" class="form-select" asp-items="ViewBag.IdiomaNativoId">
                                <option value="">-- Seleccione Idioma --</option>
                            </select>
                            <span asp-validation-for="IdiomaNativoId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Estado" class="form-label fw-bold">Estado</label>
                            <select asp-for="Estado" class="form-select">
                                <option value="A">Activo</option>
                                <option value="I">Inactivo</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light me-2">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Guardar Autor</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
