@model IEnumerable<BibliotecaUNAPEC.Models.Prestamo>

@{
    ViewData["Title"] = "Préstamos y Devoluciones";
}

<div class="card mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <h3 class="h5 mb-0">Préstamos y Devoluciones</h3>
            <small class="text-muted">Administrar préstamos y devoluciones</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-sm btn-success">Nuevo Préstamo</a>
            <a asp-action="Report" asp-controller="Prestamos" class="btn btn-sm btn-outline-primary">Reportes</a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>No.</th>
                        <th>Fecha</th>
                        <th>Libro</th>
                        <th>Usuario</th>
                        <th>Empleado</th>
                        <th class="text-end">Monto/Día</th>
                        <th class="text-end">Días</th>
                        <th class="text-end">Total</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.FechaPrestamo.ToString("yyyy-MM-dd")</td>
                            <td>@item.Libro?.Descripcion</td>
                            <td>@item.Usuario?.Nombre</td>
                            <td>@item.Empleado?.Nombre</td>
                            <td class="text-end">@item.MontoPorDia.ToString("C2")</td>
                            <td class="text-end">@item.CantidadDias</td>
                            <td class="text-end">@(item.MontoPorDia * item.CantidadDias)</td>
                            <td>
                                @if (string.Equals(item.Estado, "Activo", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-1" onclick="return confirm('¿Eliminar préstamo #'+@item.Id+'?');">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>