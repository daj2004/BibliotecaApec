@model BibliotecaUNAPEC.Models.Prestamo

@{
    ViewData["Title"] = "Editar Préstamo";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Editar Préstamo</h5>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancelar</a>
    </div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All" class="text-danger mb-2"></div>

            <div class="col-md-4">
                <label asp-for="EmpleadoId" class="form-label">Empleado</label>
                <select asp-for="EmpleadoId" asp-items="ViewBag.Empleados" class="form-select form-select-sm">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="EmpleadoId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="UsuarioId" class="form-label">Usuario</label>
                <select asp-for="UsuarioId" asp-items="ViewBag.Usuarios" class="form-select form-select-sm">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="UsuarioId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="LibroId" class="form-label">Libro</label>
                <select asp-for="LibroId" asp-items="ViewBag.Libros" class="form-select form-select-sm">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="LibroId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="FechaPrestamo" class="form-label">Fecha Préstamo</label>
                <input asp-for="FechaPrestamo" type="date" class="form-control form-control-sm" />
                <span asp-validation-for="FechaPrestamo" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="FechaDevolucion" class="form-label">Fecha Devolución</label>
                <input asp-for="FechaDevolucion" type="date" class="form-control form-control-sm" />
                <span asp-validation-for="FechaDevolucion" class="text-danger"></span>
            </div>

            <div class="col-md-2">
                <label asp-for="MontoPorDia" class="form-label">Monto x Día</label>
                <input asp-for="MontoPorDia" type="number" step="0.01" class="form-control form-control-sm" />
                <span asp-validation-for="MontoPorDia" class="text-danger"></span>
            </div>

            <div class="col-md-2">
                <label asp-for="CantidadDias" class="form-label">Cantidad de días</label>
                <input asp-for="CantidadDias" type="number" class="form-control form-control-sm" />
                <span asp-validation-for="CantidadDias" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Comentario" class="form-label">Comentario</label>
                <textarea asp-for="Comentario" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Comentario" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Estado" class="form-label">Estado</label>
                <select asp-for="Estado" class="form-select form-select-sm">
                    <option value="Activo">Activo</option>
                    <option value="Inactivo">Inactivo</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}