<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca UNAPEC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Biblioteca.styles.css" asp-append-version="true" />
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-glass fixed-top">
            <div class="container-lg">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo me-2"><i class="bi bi-book-half"></i></div>
                    <div>
                        <div class="fw-bold text-dark">Biblioteca UNAPEC</div>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Prestamos" asp-action="Index">Préstamos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Libros" asp-action="Index">Libros</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                    </ul>

                    <form class="d-flex me-3" method="get" asp-controller="Libros" asp-action="Index">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input name="search" class="form-control border-start-0 ps-0" type="search" placeholder="Buscar libros..." aria-label="Buscar">
                        </div>
                    </form>

                    <div class="d-flex align-items-center">
                        <a class="btn btn-sm btn-outline-primary me-2" asp-controller="Prestamos" asp-action="Report">
                            <i class="bi bi-bar-chart-fill me-1"></i> Reportes
                        </a>
                        <div class="dropdown">
                            <a class="btn btn-sm btn-light rounded-pill dropdown-toggle d-flex align-items-center shadow-sm" href="#" role="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="bg-primary text-white rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 0.7rem;">U</div>
                                <span class="small fw-bold">Invitado</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" aria-labelledby="userMenu">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-power me-2"></i>Cerrar sesión</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Spacer for fixed navbar -->
    <div style="height: 80px;"></div>

    <!-- Contenido principal -->
    <main role="main" class="flex-fill">
        <div class="container-lg my-4 fade-in">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer py-4 mt-auto">
        <div class="container-lg">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <div class="fw-bold mb-1">Biblioteca UNAPEC</div>
                    <small class="text-muted">&copy; @DateTime.Now.Year - Todos los derechos reservados.</small>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a class="text-muted me-3 text-decoration-none" asp-controller="Home" asp-action="AcercaDe">Acerca de</a>
                    <a class="text-muted text-decoration-none" href="#">Ayuda</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
