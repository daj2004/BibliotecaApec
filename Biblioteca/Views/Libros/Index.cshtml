@model IEnumerable<BibliotecaUNAPEC.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-4 fade-in">
    <div>
        <h1 class="fw-bold mb-0">📚 Gestión de Libros</h1>
        <p class="text-muted">Administra el catálogo bibliográfico</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Nuevo Libro
    </a>
</div>

<div class="card border-0 shadow-sm fade-in">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                        <th>@Html.DisplayNameFor(model => model.SignaturaTopografica)</th>
                        <th>@Html.DisplayNameFor(model => model.ISBN)</th>
                        <th>@Html.DisplayNameFor(model => model.TipoBibliografia)</th>
                        <th>@Html.DisplayNameFor(model => model.Ciencia)</th>
                        <th>@Html.DisplayNameFor(model => model.Estado)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="fw-bold">@Html.DisplayFor(modelItem => item.Descripcion)</td>
                            <td><span class="badge bg-light text-dark border">@Html.DisplayFor(modelItem => item.SignaturaTopografica)</span></td>
                            <td class="text-muted small">@Html.DisplayFor(modelItem => item.ISBN)</td>
                            <td>@item.TipoBibliografia?.Descripcion</td>
                            <td>@item.Ciencia?.Descripcion</td>
                            <td>
                                @if (item.Estado == 'A')
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning">@item.Estado</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light" title="Detalles"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
