@model IEnumerable<BibliotecaUNAPEC.Models.Empleado>

@{
    ViewData["Title"] = "Empleados";
}

<div class="d-flex justify-content-between align-items-center mb-4 fade-in">
    <div>
        <h1 class="fw-bold mb-0">👔 Empleados</h1>
        <p class="text-muted">Gestión del personal de la biblioteca</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus-fill me-2"></i>Nuevo Empleado
    </a>
</div>

<div class="card border-0 shadow-sm fade-in">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                        <th>@Html.DisplayNameFor(model => model.Cedula)</th>
                        <th>@Html.DisplayNameFor(model => model.TandaLaboral)</th>
                        <th class="text-end">@Html.DisplayNameFor(model => model.PorcentajeComision)</th>
                        <th>@Html.DisplayNameFor(model => model.FechaIngreso)</th>
                        <th>@Html.DisplayNameFor(model => model.Estado)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="fw-bold">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                        <i class="bi bi-person-badge text-primary"></i>
                                    </div>
                                    @Html.DisplayFor(modelItem => item.Nombre)
                                </div>
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Cedula)</td>
                            <td>
                                @if (item.TandaLaboral == "Matutina")
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning"><i class="bi bi-sun me-1"></i>Matutina</span>
                                }
                                else if (item.TandaLaboral == "Vespertina")
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info"><i class="bi bi-sunset me-1"></i>Vespertina</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark bg-opacity-10 text-dark"><i class="bi bi-moon me-1"></i>Nocturna</span>
                                }
                            </td>
                            <td class="text-end">@Html.DisplayFor(modelItem => item.PorcentajeComision)%</td>
                            <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Estado == 'A')
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light" title="Detalles"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
