@model BibliotecaUNAPEC.Models.Empleado

@{
    ViewData["Title"] = "Crear Empleado";
}

<div class="row justify-content-center fade-in">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-person-plus-fill me-2"></i>Registrar Nuevo Empleado</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre Completo</label>
                            <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ingrese el nombre completo" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Cedula" class="form-label fw-bold">Cédula</label>
                            <input asp-for="Cedula" class="form-control" placeholder="000-0000000-0" />
                            <span asp-validation-for="Cedula" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TandaLaboral" class="form-label fw-bold">Tanda Laboral</label>
                            <select asp-for="TandaLaboral" class="form-select">
                                <option value="">-- Seleccione Tanda --</option>
                                <option value="Matutina">Matutina</option>
                                <option value="Vespertina">Vespertina</option>
                                <option value="Nocturna">Nocturna</option>
                            </select>
                            <span asp-validation-for="TandaLaboral" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PorcentajeComision" class="form-label fw-bold">Porcentaje de Comisión</label>
                            <div class="input-group">
                                <input asp-for="PorcentajeComision" type="number" step="0.01" class="form-control" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="PorcentajeComision" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaIngreso" class="form-label fw-bold">Fecha de Ingreso</label>
                            <input asp-for="FechaIngreso" type="date" class="form-control" />
                            <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Estado" class="form-label fw-bold">Estado</label>
                            <select asp-for="Estado" class="form-select">
                                <option value="A">Activo</option>
                                <option value="I">Inactivo</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light me-2">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Guardar Empleado</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
