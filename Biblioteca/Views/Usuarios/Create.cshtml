@model BibliotecaUNAPEC.Models.Usuario

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="row justify-content-center fade-in">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-person-plus me-2"></i>Registrar Nuevo Usuario</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre Completo</label>
                            <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ingrese el nombre completo" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Cedula" class="form-label fw-bold">Cédula</label>
                            <input asp-for="Cedula" class="form-control" placeholder="000-0000000-0" />
                            <span asp-validation-for="Cedula" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NumeroCarnet" class="form-label fw-bold">Número de Carnet</label>
                            <input asp-for="NumeroCarnet" class="form-control" placeholder="Ej. 2023-0001" />
                            <span asp-validation-for="NumeroCarnet" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TipoPersona" class="form-label fw-bold">Tipo de Usuario</label>
                            <select asp-for="TipoPersona" class="form-select">
                                <option value="">-- Seleccione --</option>
                                <option value="Estudiante">Estudiante</option>
                                <option value="Profesor">Profesor</option>
                                <option value="Empleado">Empleado Administrativo</option>
                            </select>
                            <span asp-validation-for="TipoPersona" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Estado" class="form-label fw-bold">Estado</label>
                            <select asp-for="Estado" class="form-select">
                                <option value="A">Activo</option>
                                <option value="I">Inactivo</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light me-2">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Crear Usuario</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
